# Copy to .env. The first four beats need NOTHING from the cloud: LLM_BACKEND=ollama (or mock) + the emulator.
# What differs between the hosts (idempotent odločba, auto-stamp) is fixed in code, not by this file.

# ---- LLM backend for PreveriPriloge: mock | ollama | azure ----------------------------------
# mock   = deterministic rulebook check, no model at all (tests, panic mode)
# ollama = local model via Ollama (offline once pulled):  brew install ollama && ollama pull gpt-oss:20b
# azure  = Azure OpenAI / Foundry deployment, `az login` credential
LLM_BACKEND=ollama

# gpt-oss:20b (13 GB): best Slovene, 4-13 s per check on an M4 Max, ~30 s first load (make warm).
# qwen2.5:7b (4.7 GB): 1-2 s per check, weaker on conditional rules.
OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_HOST=http://localhost:11434

# LLM_BACKEND=azure, and the memory beat (uv run act4 ...), which always uses Azure
# AZURE_OPENAI_ENDPOINT=https://<account>.openai.azure.com/
# AZURE_OPENAI_API_KEY=            # leave empty to use `az login` (AzureCliCredential)
# AZURE_OPENAI_CHAT_COMPLETION_MODEL=gpt-5.4-mini   # the deployment name
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ---- Foundry memory (notebook 05, uv run act4 ...) ------------------------------------------
# FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_MODEL=gpt-5.4-mini
# FOUNDRY_EMBEDDING_MODEL=text-embedding-3-large
# MEMORY_STORE_NAME=ue-lipica-spomin
# AZURE_SUBSCRIPTION_ID=           # optional: pin the az CLI to the project's subscription on every command

# If the model call fails or exceeds LLM_TIMEOUT seconds, PreveriPriloge prints a red warning and falls
# back to the rulebook check (LLM_FALLBACK=0 makes it fail the step instead).
# LLM_TIMEOUT=90
# LLM_FALLBACK=1

# ---- Durable Task Scheduler ------------------------------------------------------------------
# Local emulator: docker compose up -d   (gRPC 8080, dashboard 8082)
# The Azure scheduler (make act5) takes its endpoint from act5/ (azd), not from here.
DTS_ENDPOINT=http://localhost:8080
DTS_TASKHUB=default

# ---- Demo pacing ----------------------------------------------------------------------------
# MALICA_SECONDS=6           # visible "referent pregleduje priloge" countdown = the kill window
# ZIG_PORT=8000              # the phone page (make zig); the run prints http://<laptop ip>:8000
# The auto-kill (KILL_AT=PreveriPriloge:VL-2026-0050) is read from the shell only, e.g.
#   make act2 KILL_AT=PreveriPriloge:VL-2026-0050
